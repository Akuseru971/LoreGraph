# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (optional — app runs in demo mode without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: remote champion artwork base URL
# Expected layout: {base}/portrait/{assetKey}.jpg and {base}/splash/{assetKey}.jpg
NEXT_PUBLIC_ASSET_BASE_URL=

# Optional analytics (register a sink in components/providers/index.tsx)
# NEXT_PUBLIC_ANALYTICS_WRITE_KEY=
